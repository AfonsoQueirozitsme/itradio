#
# Configuração de deploy do AzuraCast (lado do host)
# Copia este ficheiro para `.env` e ajusta conforme necessário:
#   cp .env.example .env
#

# Versão da imagem AzuraCast a correr.
# Opções: latest (estável), stable, rolling (bleeding-edge)
AZURACAST_VERSION=stable

# Portas HTTP/HTTPS expostas no host para o painel do AzuraCast.
# Deixa em 80/443 em produção. Em dev, muda para evitar conflitos
# (ex.: 8080/8443) se já tiveres algo na porta 80.
AZURACAST_HTTP_PORT=80
AZURACAST_HTTPS_PORT=443

# Porta SFTP para upload de media.
AZURACAST_SFTP_PORT=2022

# Token do túnel Cloudflare (Zero Trust → Networks → Tunnels).
# Necessário só para `npm run station:tunnel`. Deixa vazio se não usares.
CLOUDFLARE_TUNNEL_TOKEN=

# Provisionamento de utilizadores super-admin (npm run station:provision).
# ADMIN_USERS: emails separados por vírgula (def. os dois da equipa).
# ADMIN_PASSWORD: password inicial partilhada. Define no teu .env (não aqui) e
# troca-a por passwords individuais depois do primeiro login. Se ficar vazia,
# o passo de utilizadores é ignorado.
ADMIN_USERS=afonso.queiroz@bauermedia.pt,carlos.picarra@bauermedia.pt
ADMIN_PASSWORD=
